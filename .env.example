# ─── Supabase (Fase 1-2) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key: server-only, used inside /api/*.ts. NEVER prefix with VITE_
# (that would bundle it into the client). Set only in .env.local and Vercel env vars.
SUPABASE_SERVICE_ROLE_KEY=

# ─── OrkestaPay ──────────────────────────────────────────────────────────────
ORKESTA_CLIENT_ID=
ORKESTA_CLIENT_SECRET=
ORKESTA_WEBHOOK_SECRET=
ORKESTA_API_BASE_URL=https://api.sand.orkestapay.com
PUBLIC_SITE_URL=

# ─── AWS SES (Fase 5) — optional, demo works without these ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_FROM_EMAIL=

# ─── Apple Wallet (Fase 6) — optional, demo works without these ─────────────
APPLE_PASS_CERT_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=

# ─── Google Wallet (Fase 7) — optional, demo works without these ───────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_WALLET_CLASS_ID=
